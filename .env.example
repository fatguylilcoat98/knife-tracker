# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Claude Vision + translation (server-side)
# Used by /api/extract-invoice (invoice OCR) and /api/translate (EN↔ES).
# DO NOT prefix with VITE_ — this key must stay on the server, not the client.
ANTHROPIC_API_KEY=sk-ant-...

# Google Maps (optional) — enables address autocomplete on the Accounts form.
# If unset, the address field is a plain text input. Safe to leave blank.
VITE_GOOGLE_MAPS_API_KEY=
